static func index_of(id: String) -> int:
	for i in range(DATA.size()):
		if DATA[i].id == id: return i
	return 0
static func valid(id: String) -> bool:
	return DATA[index_of(id)].id == id
static func get_hero(id: String) -> Dictionary: return DATA[index_of(id)]

## Display order can change without reassigning any existing hero's audio motif.
## New heroes reuse existing stingers; the locked audio generator is untouched.
const AUDIO_IDS = ["vesper_vale","auric_rex","nyx_thread","cobalt_bastion","ember_quill","lumen_pike","shard_jack","madame_solstice","bramble_ox","kite_hollow","professor_gilt","siren_coil"]
static func audio_index(id: String) -> int:
	var original = AUDIO_IDS.find(id)
	return original if original >= 0 else {"cryon":0,"aurelia":1,"ryan_blaze":4,"tempest_vega":9}.get(id,0)
