+// Isolated real API responses for the Godot JSON/UI contract tests. No production I/O.
+import { PGlite } from '@electric-sql/pglite';
+import { readdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { handleNineweaveRequest } from '../../src/lib/nineweave/api.ts';
+import { createService } from '../../src/lib/nineweave/service.ts';
+import { pgliteDb } from '../../src/lib/nineweave/store.ts';
+const pg = new PGlite(); await pg.waitReady;
+for (const file of readdirSync('migrations').filter(f=>f.endsWith('.sql')).sort()) await pg.exec(readFileSync('migrations/'+file,'utf8'));
+let now = Date.parse('2026-11-17T12:00:00Z');
+const svc = createService({db:pgliteDb(pg),now:()=>new Date(now),limits:{write:1000,device:1000}});
+async function call(method:string,path:string,token='',body?:unknown){
+ const response = await handleNineweaveRequest(svc,new Request('http://localhost/api/nineweave'+path,{method,headers:token?{authorization:'Bearer '+token}:{},body:body===undefined?undefined:JSON.stringify(body)}));
+ return {status:response.status,body:await response.json()};
+}
+const device = await call('POST','/auth/device','',{}); const token=(device.body as any).token;
+if(device.status!==201) throw new Error('Fixture registration failed');
+const steps=[];
+for(const code of ['Blizzard','TicTacToe','010127','0704027','Patrick','Blizzard','W2026','G2026','J2026','B2026','N2026','E2026','JB2026','T2026','JY2026','GM2026','D2026','wrong']){
+ now+=61000; steps.push({code,...await call('POST','/me/unlocks',token,{code})});
+}
+const me=await call('GET','/me',token);
+const other=await call('POST','/auth/device','',{});
+const otherMe=await call('GET','/me',(other.body as any).token);
+writeFileSync('godot/tests/unlock_contract_fixture.json',JSON.stringify({steps,me,other:otherMe},null,2));
+await pg.close();
+console.log('Generated isolated API contract fixtures: 18 redemptions, two account profiles.');
